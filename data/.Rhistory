x = dt2,
lon = "decimalLongitude",
lat = "decimalLatitude",
species = "species_std",
tests = c("sea", "capitals", "centroids", "institutions"),
value = "clean"
)
dt_clean <- dt2[cc, ]
# ============================================================
# GBIF Training Data Cleaning (对齐图中方法)
# 1) Taxonomic standardization：使用 GBIF backbone taxonomy 字段
#    （优先 acceptedScientificName，其次 scientificName，再其次 species）
# 2) CoordinateCleaner：清理 sea / capitals / centroids / institutions
#
# 输出：
#   - occurrence_clean.csv
#   - cleaning_log.csv
# ============================================================
# ---------- 0) 安装/加载依赖 ----------
pkgs <- c("data.table", "dplyr", "CoordinateCleaner")
to_install <- pkgs[!pkgs %in% installed.packages()[, "Package"]]
if (length(to_install) > 0) install.packages(to_install)
library(data.table)
library(dplyr)
library(CoordinateCleaner)
# ---------- 1) 读取 GBIF 原始文件 ----------
# 改成你的文件路径（GBIF 解压后的 occurrence 文件）
infile <- "world_occurrences.csv"
# GBIF 常见是 tab 分隔；备注字段含引号，推荐 quote=""
dt <- tryCatch(
fread(infile, sep = "\t", quote = "", data.table = FALSE, encoding = "UTF-8"),
error = function(e) fread(infile, sep = ",", quote = "", data.table = FALSE, encoding = "UTF-8")
)
n_raw <- nrow(dt)
cat("Raw rows:", n_raw, "\n")
# ---------- 2) 基础字段检查 + 经纬度清理 ----------
required_cols <- c("decimalLongitude", "decimalLatitude")
missing_cols <- required_cols[!required_cols %in% names(dt)]
if (length(missing_cols) > 0) {
stop("缺少必要字段：", paste(missing_cols, collapse = ", "),
"\n请检查你的文件列名是否不同。")
}
dt$decimalLongitude <- suppressWarnings(as.numeric(dt$decimalLongitude))
dt$decimalLatitude  <- suppressWarnings(as.numeric(dt$decimalLatitude))
dt1 <- dt %>%
filter(!is.na(decimalLongitude), !is.na(decimalLatitude)) %>%
filter(decimalLongitude >= -180, decimalLongitude <= 180,
decimalLatitude  >= -90,  decimalLatitude  <= 90)
n_lonlat <- nrow(dt1)
cat("After removing NA/invalid lon-lat:", n_lonlat, "\n")
# （可选但推荐）去掉 ABSENT
if ("occurrenceStatus" %in% names(dt1)) {
dt1 <- dt1 %>% filter(toupper(occurrenceStatus) != "ABSENT")
}
n_presence <- nrow(dt1)
cat("After removing ABSENT (if any):", n_presence, "\n")
# ---------- 3) 学名标准化（对齐“U.taxostand 的方法含义”） ----------
# 优先用 GBIF backbone 已接受学名（acceptedScientificName）
# 若没有，则使用 scientificName / species
name_priority <- c("acceptedScientificName", "scientificName", "species")
name_col <- name_priority[name_priority %in% names(dt1)][1]
if (is.na(name_col) || is.null(name_col)) {
stop("找不到学名字段：acceptedScientificName / scientificName / species 都不存在。")
}
cat("Using name column:", name_col, "\n")
dt2 <- dt1 %>%
mutate(species_std = .data[[name_col]]) %>%
filter(!is.na(species_std), species_std != "")
n_tax <- nrow(dt2)
cat("After taxonomic standardization (non-NA):", n_tax, "\n")
# ---------- 4) CoordinateCleaner 坐标清洗 ----------
cc <- clean_coordinates(
x = dt2,
lon = "decimalLongitude",
lat = "decimalLatitude",
species = "species_std",
tests = c("sea", "capitals", "centroids", "institutions"),
value = "clean"
)
# 兼容不同版本 CoordinateCleaner 的返回类型：
# - 有的版本返回 data.frame（含 .summary TRUE/FALSE）
# - 老版本可能直接返回逻辑向量
if (is.data.frame(cc)) {
if (".summary" %in% names(cc)) {
keep <- cc$.summary
} else if ("summary" %in% names(cc)) {
keep <- cc$summary
} else if (".clean" %in% names(cc)) {
keep <- cc$.clean
} else {
# 兜底：所有测试列都为 TRUE 视作通过
keep <- apply(cc, 1, function(r) all(isTRUE(r)))
}
} else {
keep <- cc
}
dt_clean <- dt2[keep, , drop = FALSE]
n_coord <- nrow(dt_clean)
cat("After CoordinateCleaner:", n_coord, "\n")
# ---------- 5) 输出结果 ----------
outfile <- "occurrence_clean.csv"
write.csv(dt_clean, outfile, row.names = FALSE, fileEncoding = "UTF-8")
log <- data.frame(
step = c("raw", "lonlat_valid", "presence_filter", "taxon_std_nonNA", "coord_clean"),
n = c(n_raw, n_lonlat, n_presence, n_tax, n_coord)
)
write.csv(log, "cleaning_log.csv", row.names = FALSE, fileEncoding = "UTF-8")
cat("\n✅ Done!\nSaved:", outfile, "\nSaved: cleaning_log.csv\n")
# ============================================================
# GBIF Training Data Cleaning（最终稳定版）
# 对齐论文方法：
# 1) Taxonomic standardization（GBIF backbone taxonomy 字段）
# 2) CoordinateCleaner（sea / capitals / centroids / institutions）
#
# 输出：
#   - occurrence_clean.csv  （一定有数据）
#   - cleaning_log.csv
# ============================================================
# ---------- 0) 安装 / 加载依赖 ----------
pkgs <- c("data.table", "dplyr", "CoordinateCleaner")
to_install <- pkgs[!pkgs %in% installed.packages()[, "Package"]]
if (length(to_install) > 0) install.packages(to_install)
library(data.table)
library(dplyr)
library(CoordinateCleaner)
# ---------- 1) 读取 GBIF 原始文件 ----------
# ⚠️ 改成你的 GBIF occurrence 文件路径
infile <- "world_occurrences.csv"
dt <- tryCatch(
fread(infile, sep = "\t", quote = "", data.table = FALSE, encoding = "UTF-8"),
error = function(e)
fread(infile, sep = ",", quote = "", data.table = FALSE, encoding = "UTF-8")
)
n_raw <- nrow(dt)
cat("Raw rows:", n_raw, "\n")
# ---------- 2) 经纬度基础清洗 ----------
required_cols <- c("decimalLongitude", "decimalLatitude")
if (!all(required_cols %in% names(dt))) {
stop("缺少必要字段：decimalLongitude / decimalLatitude")
}
dt$decimalLongitude <- suppressWarnings(as.numeric(dt$decimalLongitude))
dt$decimalLatitude  <- suppressWarnings(as.numeric(dt$decimalLatitude))
dt1 <- dt %>%
filter(!is.na(decimalLongitude), !is.na(decimalLatitude)) %>%
filter(decimalLongitude >= -180, decimalLongitude <= 180,
decimalLatitude  >= -90,  decimalLatitude  <= 90)
n_lonlat <- nrow(dt1)
cat("After removing NA/invalid lon-lat:", n_lonlat, "\n")
# 去除 ABSENT（如果存在）
if ("occurrenceStatus" %in% names(dt1)) {
dt1 <- dt1 %>% filter(toupper(occurrenceStatus) != "ABSENT")
}
n_presence <- nrow(dt1)
cat("After removing ABSENT (if any):", n_presence, "\n")
# ---------- 3) 学名标准化（等价于论文中的 U.taxostand） ----------
# 优先使用 GBIF backbone taxonomy 的已接受学名
name_priority <- c("acceptedScientificName", "scientificName", "species")
name_col <- name_priority[name_priority %in% names(dt1)][1]
if (is.na(name_col)) {
stop("找不到学名字段：acceptedScientificName / scientificName / species")
}
cat("Using name column:", name_col, "\n")
dt2 <- dt1 %>%
mutate(species_std = .data[[name_col]]) %>%
filter(!is.na(species_std), species_std != "")
n_tax <- nrow(dt2)
cat("After taxonomic standardization (non-NA):", n_tax, "\n")
# ---------- 4) CoordinateCleaner（关键修复版） ----------
cc <- clean_coordinates(
x = dt2,
lon = "decimalLongitude",
lat = "decimalLatitude",
species = "species_std",
tests = c("sea", "capitals", "centroids", "institutions"),
value = "clean"
)
# ---- 关键：正确提取通过标记 ----
if (!is.data.frame(cc) || !(".summary" %in% names(cc))) {
stop("CoordinateCleaner 输出异常，请运行 str(cc)")
}
# ============================================================
# GBIF Training Data Cleaning（最终稳定版：不空表）
# 对齐论文方法：
# 1) Taxonomic standardization：基于 GBIF backbone taxonomy 字段
#    （优先 acceptedScientificName，其次 scientificName，再其次 species）
# 2) CoordinateCleaner：清理 sea / capitals / centroids / institutions
#
# 输出：
#   - occurrence_clean.csv
#   - cleaning_log.csv
# ============================================================
# ---------- 0) 安装 / 加载依赖 ----------
pkgs <- c("data.table", "dplyr", "CoordinateCleaner")
to_install <- pkgs[!pkgs %in% installed.packages()[, "Package"]]
if (length(to_install) > 0) install.packages(to_install)
library(data.table)
library(dplyr)
library(CoordinateCleaner)
# ---------- 1) 读取 GBIF 原始文件 ----------
# ⚠️ 改成你的 GBIF occurrence 文件路径
infile <- "world_occurrences.csv"
dt <- tryCatch(
fread(infile, sep = "\t", quote = "", data.table = FALSE, encoding = "UTF-8"),
error = function(e) fread(infile, sep = ",", quote = "", data.table = FALSE, encoding = "UTF-8")
)
n_raw <- nrow(dt)
cat("Raw rows:", n_raw, "\n")
# ---------- 2) 经纬度基础清洗 ----------
required_cols <- c("decimalLongitude", "decimalLatitude")
missing_cols <- required_cols[!required_cols %in% names(dt)]
if (length(missing_cols) > 0) {
stop("缺少必要字段：", paste(missing_cols, collapse = ", "),
"\n请检查你的文件列名是否不同。")
}
dt$decimalLongitude <- suppressWarnings(as.numeric(dt$decimalLongitude))
dt$decimalLatitude  <- suppressWarnings(as.numeric(dt$decimalLatitude))
dt1 <- dt %>%
filter(!is.na(decimalLongitude), !is.na(decimalLatitude)) %>%
filter(decimalLongitude >= -180, decimalLongitude <= 180,
decimalLatitude  >= -90,  decimalLatitude  <= 90)
n_lonlat <- nrow(dt1)
cat("After removing NA/invalid lon-lat:", n_lonlat, "\n")
# 去除 ABSENT（若存在）
if ("occurrenceStatus" %in% names(dt1)) {
dt1 <- dt1 %>% filter(toupper(occurrenceStatus) != "ABSENT")
}
n_presence <- nrow(dt1)
cat("After removing ABSENT (if any):", n_presence, "\n")
# ---------- 3) 学名标准化（等价于论文中 U.taxostand 的方法含义） ----------
# 优先使用 GBIF backbone taxonomy 的已接受学名
name_priority <- c("acceptedScientificName", "scientificName", "species")
name_col <- name_priority[name_priority %in% names(dt1)][1]
if (is.na(name_col) || is.null(name_col)) {
stop("找不到学名字段：acceptedScientificName / scientificName / species")
}
cat("Using name column:", name_col, "\n")
dt2 <- dt1 %>%
mutate(species_std = .data[[name_col]]) %>%
filter(!is.na(species_std), species_std != "")
n_tax <- nrow(dt2)
cat("After taxonomic standardization (non-NA):", n_tax, "\n")
# ---------- 4) CoordinateCleaner（超兼容版，保证不因返回类型而空表） ----------
cc <- clean_coordinates(
x = dt2,
lon = "decimalLongitude",
lat = "decimalLatitude",
species = "species_std",
tests = c("sea", "capitals", "centroids", "institutions"),
value = "clean"
)
keep <- NULL
# A) 直接返回逻辑向量
if (is.logical(cc) && length(cc) == nrow(dt2)) {
keep <- cc
}
# B) 返回 data.frame：尝试提取汇总列
if (is.null(keep) && is.data.frame(cc)) {
cand_cols <- c(".summary", "summary", ".clean", "clean")
col <- cand_cols[cand_cols %in% names(cc)][1]
if (!is.na(col)) keep <- cc[[col]]
}
# C) 返回 list：尝试提取汇总元素
if (is.null(keep) && is.list(cc)) {
cand_names <- c(".summary", "summary", ".clean", "clean")
nm <- cand_names[cand_names %in% names(cc)][1]
if (!is.na(nm)) keep <- cc[[nm]]
}
# 还取不到就打印信息并停止（需要你把输出贴给我）
if (is.null(keep)) {
cat("Could not extract keep vector from CoordinateCleaner output.\n")
cat("class(cc):", paste(class(cc), collapse = ","), "\n")
if (is.list(cc)) cat("names(cc):", paste(names(cc), collapse = ","), "\n")
stop("无法从 cc 中提取通过标记。")
}
# ============================================================
# GBIF Training Data Cleaning（最终兼容版）
# 1) Taxonomic standardization：GBIF backbone taxonomy 字段
# 2) CoordinateCleaner：sea / capitals / centroids / institutions
# 输出：
#   - occurrence_clean.csv
#   - cleaning_log.csv
# ============================================================
# ---------- 0) 安装 / 加载依赖 ----------
pkgs <- c("data.table", "dplyr", "CoordinateCleaner")
to_install <- pkgs[!pkgs %in% installed.packages()[, "Package"]]
if (length(to_install) > 0) install.packages(to_install)
library(data.table)
library(dplyr)
library(CoordinateCleaner)
# ---------- 1) 读取 GBIF 原始文件 ----------
infile <- "world_occurrences.csv"  # 改成你的文件路径
dt <- tryCatch(
fread(infile, sep = "\t", quote = "", data.table = FALSE, encoding = "UTF-8"),
error = function(e) fread(infile, sep = ",", quote = "", data.table = FALSE, encoding = "UTF-8")
)
n_raw <- nrow(dt)
cat("Raw rows:", n_raw, "\n")
# ---------- 2) 经纬度基础清洗 ----------
required_cols <- c("decimalLongitude", "decimalLatitude")
missing_cols <- required_cols[!required_cols %in% names(dt)]
if (length(missing_cols) > 0) {
stop("缺少必要字段：", paste(missing_cols, collapse = ", "))
}
dt$decimalLongitude <- suppressWarnings(as.numeric(dt$decimalLongitude))
dt$decimalLatitude  <- suppressWarnings(as.numeric(dt$decimalLatitude))
dt1 <- dt %>%
filter(!is.na(decimalLongitude), !is.na(decimalLatitude)) %>%
filter(decimalLongitude >= -180, decimalLongitude <= 180,
decimalLatitude  >= -90,  decimalLatitude  <= 90)
n_lonlat <- nrow(dt1)
cat("After removing NA/invalid lon-lat:", n_lonlat, "\n")
if ("occurrenceStatus" %in% names(dt1)) {
dt1 <- dt1 %>% filter(toupper(occurrenceStatus) != "ABSENT")
}
n_presence <- nrow(dt1)
cat("After removing ABSENT (if any):", n_presence, "\n")
# ---------- 3) 学名标准化（等价于论文中的 U.taxostand 语义） ----------
name_priority <- c("acceptedScientificName", "scientificName", "species")
name_col <- name_priority[name_priority %in% names(dt1)][1]
if (is.na(name_col) || is.null(name_col)) {
stop("找不到学名字段：acceptedScientificName / scientificName / species")
}
cat("Using name column:", name_col, "\n")
dt2 <- dt1 %>%
mutate(species_std = .data[[name_col]]) %>%
filter(!is.na(species_std), species_std != "")
n_tax <- nrow(dt2)
cat("After taxonomic standardization (non-NA):", n_tax, "\n")
# ---------- 4) CoordinateCleaner（兼容你的版本：可能直接返回 cleaned data.frame） ----------
cc <- clean_coordinates(
x = dt2,
lon = "decimalLongitude",
lat = "decimalLatitude",
species = "species_std",
tests = c("sea", "capitals", "centroids", "institutions"),
value = "clean"
)
# 关键：判断 cc 返回了什么
# 情况 A：返回逻辑向量 -> 用来筛 dt2
# 情况 B：返回 data.frame 且带 .summary/.clean 等列 -> 按列筛
# 情况 C：返回 data.frame 但不带任何结果列（你现在就是这种）-> 直接视为 cleaned data.frame
dt_clean <- NULL
if (is.logical(cc) && length(cc) == nrow(dt2)) {
dt_clean <- dt2[cc, , drop = FALSE]
cat("CoordinateCleaner returned logical vector.\n")
} else if (is.data.frame(cc)) {
# 如果带汇总列，就用汇总列筛
cand_cols <- c(".summary", "summary", ".clean", "clean")
col <- cand_cols[cand_cols %in% names(cc)][1]
if (!is.na(col)) {
keep <- cc[[col]]
if (is.factor(keep)) keep <- as.character(keep)
keep <- as.logical(keep)
keep[is.na(keep)] <- FALSE
dt_clean <- cc[keep, , drop = FALSE]
cat("CoordinateCleaner returned data.frame with summary column:", col, "\n")
} else {
# 你当前版本：cc 本身就是 cleaned data.frame（或至少没有返回筛选列）
dt_clean <- cc
cat("CoordinateCleaner returned cleaned data.frame (no summary column found).\n")
}
} else if (is.list(cc)) {
# 少数版本可能返回 list：尝试从 list 里取 data 或 summary
if ("data" %in% names(cc) && is.data.frame(cc$data)) {
dt_clean <- cc$data
cat("CoordinateCleaner returned list with $data.\n")
} else {
stop("CoordinateCleaner 返回 list 但无法识别结构，请运行 str(cc) 并把输出贴给我。")
}
} else {
stop("无法识别 CoordinateCleaner 返回类型：", paste(class(cc), collapse = ","))
}
n_coord <- nrow(dt_clean)
cat("After CoordinateCleaner:", n_coord, "\n")
# 兜底保护：防止意外变空（理论上你这里不会）
if (n_coord == 0) {
stop("dt_clean 变成 0 行了。请运行：str(cc); head(cc) 并把输出贴给我。")
}
# ---------- 5) 输出结果 ----------
write.csv(dt_clean, "occurrence_clean.csv", row.names = FALSE, fileEncoding = "UTF-8")
log <- data.frame(
step = c("raw", "lonlat_valid", "presence_filter", "taxon_std_nonNA", "coord_clean"),
n = c(n_raw, n_lonlat, n_presence, n_tax, n_coord)
)
write.csv(log, "cleaning_log.csv", row.names = FALSE, fileEncoding = "UTF-8")
cat("\n✅ Done!\nSaved: occurrence_clean.csv\nSaved: cleaning_log.csv\n")
# ============================================================
# GBIF occurrence cleaning pipeline
# - Taxonomic name standardization (GBIF backbone fields)
# - Coordinate cleaning with CoordinateCleaner
#
# Outputs:
#   occurrence_clean.csv
#   cleaning_log.csv
# ============================================================
suppressPackageStartupMessages({
library(data.table)
library(dplyr)
library(CoordinateCleaner)
})
# --------------------------- user parameters ---------------------------
infile  <- "world_occurrences.csv"     # GBIF download (unzipped)
outfile <- "occurrence_clean.csv"
logfile <- "cleaning_log.csv"
# Name standardization: priority order
name_priority <- c("acceptedScientificName", "scientificName", "species")
# CoordinateCleaner tests (as in manuscript)
cc_tests <- c("sea", "capitals", "centroids", "institutions")
# --------------------------- helpers ---------------------------
read_gbif <- function(path) {
if (!file.exists(path)) stop("Input file not found: ", path)
# GBIF exports are often tab-delimited, occasionally comma-delimited
tryCatch(
fread(path, sep = "\t", quote = "", data.table = FALSE, encoding = "UTF-8"),
error = function(e) fread(path, sep = ",", quote = "", data.table = FALSE, encoding = "UTF-8")
)
}
pick_first_existing <- function(candidates, cols) {
hit <- candidates[candidates %in% cols]
if (length(hit) == 0) return(NA_character_)
hit[1]
}
as_logical_strict <- function(x) {
# Accept logical, factor, character ("TRUE"/"FALSE")
if (is.logical(x)) return(replace(x, is.na(x), FALSE))
if (is.factor(x)) x <- as.character(x)
if (is.character(x)) {
y <- as.logical(x)
return(replace(y, is.na(y), FALSE))
}
# last resort
y <- suppressWarnings(as.logical(x))
replace(y, is.na(y), FALSE)
}
extract_cleaned_from_cc <- function(cc, original_df) {
# CoordinateCleaner return behavior varies by version.
# Handle: logical vector; data.frame with summary column; data.frame already cleaned; list with $data.
if (is.logical(cc) && length(cc) == nrow(original_df)) {
return(original_df[cc, , drop = FALSE])
}
if (is.data.frame(cc)) {
# If a summary/clean column exists, filter by it; otherwise treat cc as cleaned data.
cand_cols <- c(".summary", "summary", ".clean", "clean")
col <- pick_first_existing(cand_cols, names(cc))
if (!is.na(col)) {
keep <- as_logical_strict(cc[[col]])
return(cc[keep, , drop = FALSE])
}
return(cc)
}
if (is.list(cc) && "data" %in% names(cc) && is.data.frame(cc$data)) {
return(cc$data)
}
stop("Unrecognized CoordinateCleaner output type: ", paste(class(cc), collapse = ", "))
}
# --------------------------- pipeline ---------------------------
counts <- list()
dt <- read_gbif(infile)
counts$raw <- nrow(dt)
required <- c("decimalLongitude", "decimalLatitude")
missing_required <- setdiff(required, names(dt))
if (length(missing_required) > 0) {
stop("Missing required columns: ", paste(missing_required, collapse = ", "))
}
dt <- dt %>%
mutate(
decimalLongitude = suppressWarnings(as.numeric(decimalLongitude)),
decimalLatitude  = suppressWarnings(as.numeric(decimalLatitude))
) %>%
filter(
!is.na(decimalLongitude), !is.na(decimalLatitude),
decimalLongitude >= -180, decimalLongitude <= 180,
decimalLatitude  >= -90,  decimalLatitude  <= 90
)
counts$lonlat_valid <- nrow(dt)
if ("occurrenceStatus" %in% names(dt)) {
dt <- dt %>% filter(toupper(occurrenceStatus) != "ABSENT")
}
counts$presence_filter <- nrow(dt)
name_col <- pick_first_existing(name_priority, names(dt))
if (is.na(name_col)) {
stop("No usable name column found. Checked: ", paste(name_priority, collapse = ", "))
}
dt <- dt %>%
mutate(species_std = .data[[name_col]]) %>%
filter(!is.na(species_std), species_std != "")
counts$taxon_std_nonNA <- nrow(dt)
cc <- clean_coordinates(
x       = dt,
lon     = "decimalLongitude",
lat     = "decimalLatitude",
species = "species_std",
tests   = cc_tests,
value   = "clean"
)
dt_clean <- extract_cleaned_from_cc(cc, dt)
counts$coord_clean <- nrow(dt_clean)
if (counts$coord_clean == 0) {
stop("No records left after coordinate cleaning. Check inputs/tests.")
}
# --------------------------- outputs ---------------------------
write.csv(dt_clean, outfile, row.names = FALSE, fileEncoding = "UTF-8")
log_df <- data.frame(
step = names(counts),
n    = as.integer(unlist(counts)),
stringsAsFactors = FALSE
)
write.csv(log_df, logfile, row.names = FALSE, fileEncoding = "UTF-8")
message("Done.")
message("Input:  ", infile)
message("Output: ", outfile, " (rows = ", counts$coord_clean, ")")
message("Log:    ", logfile)
